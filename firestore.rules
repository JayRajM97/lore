rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    // Public catalog: world-readable, writes only via Admin SDK (sidecar).
    match /global_newsletters/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /global_episodes/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // gmail_tokens: no match block -> default deny for all clients.
  }
}
